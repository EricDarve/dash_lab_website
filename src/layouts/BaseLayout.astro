---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  narrow?: boolean;
}

const {
  title,
  description = "DASH Lab is Eric Darve's research group at Stanford University, working on machine learning and numerical methods for science and engineering.",
  narrow = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · DASH Lab` : "DASH Lab"}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer narrow={narrow} />
  </body>
</html>
