---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackPill from "../../components/BackPill.astro";
import {
  researchAreas,
  legacyResearchAreas,
  sectionParagraphs,
} from "../../data/researchAreas";
import { researchStreamLabel } from "../../data/researchStreams";

export async function getStaticPaths() {
  // Legacy areas keep their /research/<slug> pages (old links still work)
  // even though the homepage no longer lists them.
  return [...researchAreas, ...legacyResearchAreas].map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;

const people = await getCollection("people");

const lastName = (name: string) => name.split(" ").pop() ?? name;

const relatedPeople = people
  .filter(
    (person) =>
      !person.data.placeholder &&
      person.data.category !== "alumni" &&
      person.data.pills?.some((slug) => area.pills.includes(slug))
  )
  .sort((a, b) => lastName(a.data.name).localeCompare(lastName(b.data.name)));

const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// The outer page frame is the site-wide .container (--container in
// global.css); BackPill's desktop rail needs the number so it stops short
// of it. Inside, .research-frame (--research-frame) bounds the content.
const FRAME_WIDTH = 1120;
---

<!-- Layout: the shared .research-detail rules in src/styles/global.css. -->
<BaseLayout title={area.title} description={area.description}>
  <section class="section research-detail">
    <div class="container">
      <BackPill href={`${base}/#research`} column={FRAME_WIDTH} />

      <div class="research-frame">
      <h1 class="research-detail__title">{area.title}</h1>

      {area.sections.map((section) => (
        <div class="research-detail__section">
          {section.heading && (
            <h2 class="research-detail__subheading">{section.heading}</h2>
          )}
          {sectionParagraphs(section).map((segments) => (
            <p class="research-detail__prose">
              {segments.map((segment) =>
                segment.url ? (
                  <a href={segment.url} target="_blank" rel="noopener">{segment.text}</a>
                ) : (
                  segment.text
                )
              )}
            </p>
          ))}
        </div>
      ))}

      <div class="pill-row research-detail__tags">
        {area.pills.map((slug) => (
          <span class="tag">{researchStreamLabel(slug)}</span>
        ))}
      </div>

      {relatedPeople.length > 0 && (
        <div class="research-detail__people">
          <p class="eyebrow">People in this area</p>
          <div class="research-detail__grid">
            {relatedPeople.map((person) => (
              <a href={`${base}/member/${person.id}/`} class="person-card">
                <div class="person-meta">
                  {person.data.photo ? (
                    <img src={`${base}${person.data.photo}`} alt={person.data.name} class="avatar" width="84" height="84" loading="lazy" decoding="async" />
                  ) : (
                    <div class="avatar avatar--initials">{initials(person.data.name)}</div>
                  )}
                  <div class="person-meta__text">
                    <h3 class="row__title">{person.data.name}</h3>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* BackPill's hover rail only has room beside the 1120px frame on wide
     screens; narrower desktops use the inline "← DASH Lab" link instead.
     (Kept here, not in global.css, because it must out-rank BackPill's own
     scoped rules.) */
  @media (max-width: 1279px) {
    .research-detail :global(.back-rail) {
      display: none;
    }

    .research-detail :global(.back-link) {
      display: inline-block;
    }
  }
</style>
