---
// Simple back-to-home pill: static "‹ DASH Lab", subtle hover.
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a href={href} class="back-pill">&lsaquo;&nbsp; DASH Lab</a>

<style>
  .back-pill {
    display: inline-block;
    padding: 7px 14px;
    background: var(--paper-alt);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-secondary);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .back-pill:hover {
    color: var(--cardinal);
    border-color: var(--cardinal);
  }
</style>
